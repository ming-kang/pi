{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"@astralyn/pi": ["./src/index.ts"],
			"@astralyn/pi/*": ["./src/*"],
			"@earendil-works/pi-coding-agent": ["./src/index.ts"],
			"@earendil-works/pi-ai": ["./src/core/extensions/pi-ai-extension-view.ts"]
		}
	},
	"include": ["examples/**/*.ts", "src/**/*.d.ts"],
	"exclude": ["node_modules", "dist", "examples/extensions/gondolin/**"]
}
