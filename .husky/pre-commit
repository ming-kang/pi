#!/bin/sh

STAGED_FILES=$(git diff --cached --name-only)

node scripts/check-lockfile-commit.mjs || exit 1

# Format first, then run the read-only package checks.
echo "Running formatting..."
npm run format || exit 1

echo "Running linting, dependency, lockfile, and type checks..."
npm run check || exit 1

# Restage files that were already staged and may have been formatted.
for file in $STAGED_FILES; do
  if [ -f "$file" ]; then
    git add "$file"
  fi
done

echo "✅ All pre-commit checks passed!"
