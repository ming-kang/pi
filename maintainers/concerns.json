{
	"version": 2,
	"concerns": [
		{
			"id": "distribution-identity",
			"why": "Standalone @astralyn/pi packaging, identity, update source, and disabled install telemetry.",
			"paths": [
				{ "path": ".gitignore" },
				{ "path": "CHANGELOG.md" },
				{ "path": "README.md" },
				{ "path": "examples/" },
				{ "path": "install-lock/" },
				{ "path": "npm-shrinkwrap.json" },
				{ "path": "package.json" },
				{ "path": "scripts/migrate-sessions.sh" },
				{
					"path": "src/cli/startup-ui.ts",
					"anchors": ["isPrimaryDistribution", "DISTRIBUTION_PACKAGE_NAME"],
					"rewrite": "The first-run gate compares against this distribution's package metadata, replacing upstream's official-distribution constants."
				},
				{
					"path": "src/config.ts",
					"anchors": ["DISTRIBUTION_PACKAGE_NAME", "INSTALL_TELEMETRY_URL", "UPDATE_CHANGELOG_HINT"]
				},
				{
					"path": "src/core/extensions/loader.ts",
					"anchors": ["resolveImport", "DISTRIBUTION_PACKAGE_NAME"],
					"rewrite": "The standalone package resolves bundled libraries from node_modules only, so upstream's monorepo workspace lookup is removed."
				},
				{ "path": "src/core/extensions/virtual-modules.ts", "anchors": ["DISTRIBUTION_PACKAGE_NAME"] },
				{ "path": "src/experimental/plugins/bundled.ts", "anchors": ["DISTRIBUTION_PLUGIN_API"] },
				{ "path": "src/experimental/source-resolver.ts", "anchors": ["repositoryRoot"] },
				{
					"path": "src/modes/interactive/interactive-mode.ts",
					"anchors": ["INSTALL_TELEMETRY_URL", "UPDATE_CHANGELOG_HINT"]
				},
				{ "path": "src/modes/interactive/components/settings-selector.ts" },
				{
					"path": "src/utils/syntax-highlight.ts",
					"anchors": ["loadAllHighlightLanguages"],
					"rewrite": "Repository source policy loads every grammar through static imports instead of upstream's deferred dynamic import."
				},
				{
					"path": "src/utils/version-check.ts",
					"anchors": ["LATEST_VERSION_URL"],
					"rewrite": "Update checks read the npm registry, whose response replaces upstream's pi.dev payload fields."
				},
				{ "path": "tsconfig.build.json" },
				{ "path": "tsconfig.examples.json" },
				{ "path": "vitest.config.ts" }
			],
			"tests": [
				"test/version-check.test.ts",
				"test/syntax-highlight.test.ts",
				"test/extensions-discovery.test.ts",
				"test/suite/regressions/8237-node-sea-extension-loading.test.ts"
			]
		},
		{
			"id": "bundled-extensions",
			"why": "The distribution's bundled extensions load as hidden built-ins.",
			"paths": [{ "path": "src/extensions/index.ts", "anchors": ["backgroundExtension", "btwExtension"] }]
		},
		{
			"id": "background-execution",
			"why": "Supervision, delivery, and bounded retention of background and foreground shell and Subagent executions.",
			"paths": [
				{
					"path": "src/core/agent-session.ts",
					"anchors": ["_backgroundHost", "_withBackgroundPaused", "_deliverBackgroundCompletion", "_persistMessage"],
					"rewrite": "Delivery acknowledgements, the nextTurn persistence contract, and the prompt preflight pause sit inside upstream method bodies; lifecycle pauses are shells over upstream-shaped *Body methods."
				},
				{ "path": "src/core/agent-session-runtime.ts", "anchors": ["withBackgroundPaused"] },
				{ "path": "src/core/agent-session-services.ts", "anchors": ["executionRole"] },
				{ "path": "src/core/export-html/tool-renderer.ts", "anchors": ["isPartial"] },
				{ "path": "src/core/extensions/index.ts", "anchors": ["BackgroundContext"] },
				{ "path": "src/core/extensions/runner.ts", "anchors": ["getBackground", "unboundBackground"] },
				{ "path": "src/core/extensions/types.ts", "anchors": ["getBackground", "BackgroundContext"] },
				{ "path": "src/core/sdk.ts", "anchors": ["executionRole"] },
				{
					"path": "src/core/tools/bash.ts",
					"anchors": ["runShellCommand"],
					"rewrite": "Shell calls run through session supervision and the shared shell-execution pipeline, replacing upstream's inline execution path."
				},
				{ "path": "src/core/tools/output-accumulator.ts", "anchors": ["persistFromStart"] },
				{ "path": "src/core/tools/powershell.ts" },
				{
					"path": "src/core/usage-totals.ts",
					"anchors": ["getAccountedUsages", "BACKGROUND_USAGE_TYPE"],
					"rewrite": "The background-usage ledger counts once per task, which turns upstream's accounting loop into a shared generator."
				},
				{ "path": "src/index.ts", "anchors": ["BackgroundService"] },
				{
					"path": "src/modes/interactive/components/footer.ts",
					"anchors": ["getAccountedUsages"],
					"rewrite": "Footer totals read the shared accounted-usage ledger instead of summing session entries inline."
				},
				{ "path": "src/modes/interactive/interactive-mode.ts", "anchors": ["backgroundEnabled"] }
			],
			"tests": [
				"test/agent-session-background.test.ts",
				"test/agent-session-runtime-events.test.ts",
				"test/agent-session-stats.test.ts",
				"test/background-extension.test.ts",
				"test/background-manager.test.ts",
				"test/background-retention.test.ts",
				"test/background-usage.test.ts",
				"test/bash-background.test.ts",
				"test/footer-width.test.ts",
				"test/suite/agent-session-compaction.test.ts",
				"test/suite/compaction-budget.test.ts"
			]
		},
		{
			"id": "context-snapshot",
			"why": "Extensions capture detached, stable model input and request settings without writing to the session.",
			"paths": [
				{ "path": "src/core/agent-session.ts", "anchors": ["getContextSnapshot", "_captureModelContext"] },
				{ "path": "src/core/extensions/index.ts", "anchors": ["ContextSnapshot"] },
				{ "path": "src/core/extensions/runner.ts", "anchors": ["getContextSnapshotFn"] },
				{ "path": "src/core/extensions/types.ts", "anchors": ["getContextSnapshot"] },
				{
					"path": "src/core/sdk.ts",
					"anchors": ["ContextSnapshotCapture", "resolveModelStreamOptions"],
					"rewrite": "Request options and the recorded model-input prefix move into modules that other context consumers share, replacing upstream's inline builders."
				},
				{ "path": "src/index.ts", "anchors": ["ContextSnapshot"] }
			],
			"tests": ["test/context-snapshot.test.ts", "test/sdk-stream-options.test.ts"]
		},
		{
			"id": "compaction-trigger-percent",
			"why": "Auto-compaction triggers at a percentage of the context window by converting it into upstream's reserveTokens.",
			"paths": [
				{
					"path": "src/core/settings-manager.ts",
					"anchors": ["triggerPercentBudget", "getCompactionTriggerPercent"],
					"rewrite": "Deriving the reserve from triggerPercent needs the configured-versus-default split inside upstream's compaction settings resolver."
				}
			],
			"tests": ["test/compaction-settings.test.ts", "test/settings-manager-compaction.test.ts"]
		},
		{
			"id": "tui-fullscreen-default",
			"why": "The interactive TUI defaults to fullscreen mode.",
			"paths": [
				{ "path": "src/cli/args.ts" },
				{ "path": "src/core/settings-manager.ts" },
				{ "path": "src/modes/interactive/components/settings-selector.ts" }
			]
		},
		{
			"id": "tool-presentation",
			"why": "Native tool rows use the distribution's dot/rail chrome, collapsed hints, and renderer disposal.",
			"paths": [
				{ "path": "src/core/tools/edit.ts" },
				{ "path": "src/core/tools/render-utils.ts", "anchors": ["collapsedLinesHint"] },
				{
					"path": "src/core/tools/renderers/",
					"rewrite": "Fork call lines and collapsed bodies replace parts of upstream's extracted renderers."
				},
				{ "path": "src/modes/interactive/components/custom-message.ts", "anchors": ["isPlainPrimaryClick"] },
				{
					"path": "src/modes/interactive/components/extension-selector.ts",
					"anchors": ["keyLabel"],
					"rewrite": "Selector hints resolve each configured key instead of upstream's fixed hint line."
				},
				{ "path": "src/modes/interactive/components/keybinding-hints.ts", "anchors": ["keyLabel", "formatKeyLabel"] },
				{
					"path": "src/modes/interactive/components/tool-execution.ts",
					"rewrite": "Dot/rail chrome assembly is interleaved with upstream's call/result shell, so it cannot sit outside the component."
				},
				{ "path": "src/modes/interactive/interactive-mode.ts", "anchors": ["disposeChatRows", "PendingToolMap"] },
				{
					"path": "src/modes/interactive/theme/theme.ts",
					"anchors": ["THEME_BACKGROUND_KEYS", "BUILTIN_THEME_NAMES"],
					"rewrite": "Nested color restoration and the bundled theme list change upstream's color and theme-loading functions in place."
				}
			],
			"tests": [
				"test/bash-tool-rendering.test.ts",
				"test/custom-message.test.ts",
				"test/edit-tool-no-full-redraw.test.ts",
				"test/extension-selector.test.ts",
				"test/keybinding-hints.test.ts",
				"test/theme-picker.test.ts",
				"test/tool-execution-component.test.ts"
			]
		},
		{
			"id": "tool-grouping",
			"why": "Consecutive tool calls that share a toolGroup collapse into one summary row.",
			"paths": [
				{ "path": "src/core/extensions/types.ts", "anchors": ["toolGroup", "toolGroupSummary"] },
				{ "path": "src/core/tools/find.ts", "anchors": ["toolGroup"] },
				{ "path": "src/core/tools/grep.ts", "anchors": ["toolGroup"] },
				{ "path": "src/core/tools/ls.ts", "anchors": ["toolGroup"] },
				{ "path": "src/core/tools/read.ts", "anchors": ["toolGroup"] },
				{ "path": "src/core/tools/tool-definition-wrapper.ts", "anchors": ["toolGroup"] },
				{ "path": "src/modes/interactive/components/tool-execution.ts" },
				{ "path": "src/modes/interactive/interactive-mode.ts", "anchors": ["appendToolRow", "isToolChatComponent"] }
			],
			"tests": ["test/tool-execution-component.test.ts", "test/tools.test.ts"]
		},
		{
			"id": "extension-editor-host",
			"why": "Extensions reach the main editor through ctx.ui.editorHost: submit interception, cursor, and editor-scoped input.",
			"paths": [
				{ "path": "src/core/extensions/index.ts", "anchors": ["EditorHost", "EditorSubmitHandler"] },
				{ "path": "src/core/extensions/types.ts", "anchors": ["editorHost"] },
				{ "path": "src/index.ts", "anchors": ["EditorHost"] },
				{ "path": "src/modes/interactive/interactive-mode.ts", "anchors": ["editorHost", "InteractiveEditorHost"] }
			],
			"tests": [
				"test/interactive-editor-submit.test.ts",
				"test/btw-extension.test.ts",
				"test/interactive-tui.test.ts"
			]
		},
		{
			"id": "extension-context",
			"why": "Extensions get one canonical guarded ExtensionContext with the session's ModelRuntime and a detectable stale-context error.",
			"paths": [
				{ "path": "src/core/agent-session.ts", "anchors": ["STALE_EXTENSION_CONTEXT_MESSAGE"] },
				{ "path": "src/core/extensions/index.ts", "anchors": ["isStaleExtensionContextError"] },
				{ "path": "src/core/extensions/loader.ts", "anchors": ["STALE_EXTENSION_CONTEXT_MESSAGE"] },
				{ "path": "src/core/extensions/runner.ts", "anchors": ["modelRuntime"] },
				{ "path": "src/core/extensions/types.ts", "anchors": ["modelRuntime", "isStaleExtensionContextError"] },
				{ "path": "src/core/model-registry.ts", "anchors": ["getRuntime"] },
				{
					"path": "src/modes/interactive/interactive-mode.ts",
					"anchors": ["createContext"],
					"rewrite": "Shortcut handlers receive the canonical ExtensionContext, which removes upstream's hand-built shortcut context."
				}
			],
			"tests": ["test/extensions-runner.test.ts"]
		},
		{
			"id": "provider-editor-support",
			"why": "The bundled /provider editor validates and edits the models.json the runtime loads.",
			"paths": [
				{ "path": "src/core/model-config.ts", "anchors": ["OpenAICompletionsCompatSchema", "supportsThinkingTokenBudget"] },
				{ "path": "src/core/model-runtime.ts", "anchors": ["getModelsPath"] }
			],
			"tests": ["test/provider-compat-fields.test.ts", "test/model-registry.test.ts"]
		},
		{
			"id": "keybindings",
			"why": "Extensions register their own configurable keybindings; core merges the registry and reserves the detach key.",
			"paths": [
				{ "path": "src/core/keybindings.ts", "anchors": ["getRegisteredKeybindings"] },
				{ "path": "src/core/extensions/runner.ts", "anchors": ["app.backgroundTasks.detach"] }
			],
			"tests": ["test/keybinding-registry.test.ts", "test/keybindings.test.ts"]
		},
		{
			"id": "windows-path-identity",
			"why": "Path comparisons survive Windows drive-letter case, because realpathSync keeps the caller's spelling.",
			"paths": [
				{ "path": "src/core/resource-loader.ts", "anchors": ["samePath", "isPathInside"] },
				{ "path": "src/core/trust-manager.ts", "anchors": ["findPathKeys", "userAgentsSkillsDirMatcher"] }
			],
			"tests": ["test/resource-loader.test.ts", "test/trust-manager.test.ts"]
		},
		{
			"id": "windows-shell-normalization",
			"why": "CMD-style nul redirects become /dev/null so POSIX shells on Windows cannot create undeletable nul files.",
			"paths": [{ "path": "src/core/tools/bash.ts", "anchors": ["rewriteCmdNulRedirects", "normalizeLocalBashCommand"] }],
			"tests": ["test/bash-nul-redirect.test.ts"]
		},
		{
			"id": "windows-find-glob",
			"why": "Path-segment globs in find work on Windows, where fd matches no slash-containing pattern.",
			"paths": [{ "path": "src/core/tools/find.ts", "anchors": ["matchesFindResultPath", "needsWindowsPathFilter"] }],
			"tests": [
				"test/suite/regressions/3302-find-path-glob.test.ts",
				"test/suite/regressions/6104-find-root-relativization.test.ts"
			],
			"watch": "A managed fd release matches slash-containing globs on Windows and the native slash and backslash regressions pass without the fallback."
		},
		{
			"id": "windows-external-editor",
			"why": "External editor commands parse quotes and spawn without a shell, so a TEMP path with spaces stays one argument.",
			"paths": [{ "path": "src/modes/interactive/external-editor.ts", "anchors": ["parseEditorCommand"] }],
			"tests": ["test/external-editor.test.ts"]
		},
		{
			"id": "auth-min-expiry",
			"why": "Uppercase --min-expiry units parse as minutes and seconds instead of hours.",
			"paths": [{ "path": "src/cli/auth-command.ts", "anchors": ["toLowerCase"] }],
			"tests": ["test/credential-print.test.ts"]
		},
		{
			"id": "docs-and-tests",
			"why": "Distribution-owned user documentation and tests that track the standalone layout and registered deviations.",
			"paths": [{ "path": "docs/" }, { "path": "test/" }]
		}
	]
}
