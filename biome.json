{
	"$schema": "https://biomejs.dev/schemas/2.3.5/schema.json",
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noNonNullAssertion": "off",
				"useConst": "error",
				"useNodejsImportProtocol": "off"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noControlCharactersInRegex": "off",
				"noEmptyInterface": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "tab",
		"indentWidth": 3,
		"lineWidth": 120
	},
	"files": {
		"includes": [
			"src/**/*.ts",
			"test/**/*.ts",
			"examples/**/*.ts",
			"scripts/**/*.ts",
			"scripts/**/*.mjs",
			"*.ts",
			"*.json",
			"!**/node_modules/**/*",
			"!**/test-sessions.ts",
			"!test/fixtures/**/*",
			"!npm-shrinkwrap.json",
			"!package-lock.json",
			"!!**/node_modules"
		]
	}
}
