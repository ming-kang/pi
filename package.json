{
	"name": "@astralyn/pi",
	"version": "0.86.1",
	"description": "Coding agent CLI with read, bash, edit, write tools and session management",
	"type": "module",
	"piConfig": {
		"configDir": ".pi"
	},
	"bin": {
		"pi": "dist/bundle/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./rpc-entry": {
			"import": "./dist/bundle/rpc-entry.js"
		},
		"./client": {
			"source": "./src/client/index.ts"
		},
		"./experimental/plugin": {
			"source": "./src/experimental/plugin.ts"
		}
	},
	"files": [
		"dist",
		"!dist/client",
		"!dist/experimental",
		"!dist/cli/experimental",
		"docs",
		"examples",
		"CHANGELOG.md",
		"npm-shrinkwrap.json"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"prebuild": "npm run check:installed-deps",
		"build": "npm run build:unbundled && npm run build:bundle",
		"build:unbundled": "tsc -p tsconfig.build.json && shx chmod +x dist/cli.js dist/rpc-entry.js && npm run copy-assets",
		"build:bundle": "node scripts/build-bundle.mjs",
		"copy-assets": "shx mkdir -p dist/modes/interactive/theme && shx cp src/modes/interactive/theme/*.json dist/modes/interactive/theme/ && shx mkdir -p dist/modes/interactive/assets && shx cp src/modes/interactive/assets/*.png dist/modes/interactive/assets/ && shx mkdir -p dist/core/export-html/vendor && shx cp src/core/export-html/template.html src/core/export-html/template.css src/core/export-html/template.js dist/core/export-html/ && shx cp src/core/export-html/vendor/*.js dist/core/export-html/vendor/",
		"dev": "node scripts/run-source.mjs",
		"format": "biome check --write .",
		"check": "npm run check:installed-deps && biome check --error-on-warnings . && npm run check:pinned-deps && npm run check:ts-imports && npm run check:docs && tsc --noEmit && tsc -p tsconfig.examples.json",
		"check:installed-deps": "node scripts/check-installed-deps.mjs",
		"check:pinned-deps": "node scripts/check-pinned-deps.mjs",
		"check:ts-imports": "node scripts/check-ts-relative-imports.mjs",
		"check:docs": "node scripts/check-docs.mjs",
		"test": "vitest --run",
		"pretest": "npm run check:installed-deps",
		"test:isolated": "node scripts/test-isolated.mjs",
		"diff:upstream": "node scripts/diff-upstream.mjs",
		"verify:package-install": "node scripts/verify-package-install.mjs",
		"profile:tui": "node scripts/profile-node.mjs --mode tui",
		"profile:rpc": "node scripts/profile-node.mjs --mode rpc",
		"shrinkwrap": "npm install --package-lock-only --ignore-scripts",
		"prepare": "husky",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"dependencies": {
		"@earendil-works/chord": "0.86.1",
		"@earendil-works/pi-agent-core": "0.86.1",
		"@earendil-works/pi-ai": "0.86.1",
		"@earendil-works/pi-tui": "0.86.1",
		"@silvia-odwyer/photon-node": "0.3.4",
		"chalk": "6.0.0",
		"cross-spawn": "7.0.6",
		"diff": "8.0.4",
		"grok-mermaid": "0.2.3",
		"highlight.js": "10.7.3",
		"hosted-git-info": "9.0.3",
		"ignore": "7.0.8",
		"jiti": "2.7.0",
		"minimatch": "10.2.6",
		"proper-lockfile": "4.1.2",
		"semver": "7.8.5",
		"typebox": "1.3.27",
		"undici": "8.10.2",
		"yaml": "2.9.0"
	},
	"devDependencies": {
		"@anthropic-ai/sandbox-runtime": "0.0.26",
		"@anthropic-ai/sdk": "0.52.0",
		"@biomejs/biome": "2.3.5",
		"@earendil-works/pi-client": "0.86.1",
		"@earendil-works/pi-protocol": "0.86.1",
		"@earendil-works/pi-server": "0.86.1",
		"@types/cross-spawn": "6.0.6",
		"@types/hosted-git-info": "3.0.5",
		"@types/ms": "2.1.0",
		"@types/node": "24.12.4",
		"@types/proper-lockfile": "4.1.4",
		"@types/semver": "7.7.1",
		"@xterm/headless": "5.5.0",
		"esbuild": "0.28.2",
		"husky": "9.1.7",
		"marked": "18.0.11",
		"ms": "2.1.3",
		"shx": "0.4.0",
		"tsx": "4.22.1",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	},
	"overrides": {
		"brace-expansion": "5.0.9",
		"protobufjs": "7.6.6"
	},
	"keywords": [
		"coding-agent",
		"ai",
		"llm",
		"cli",
		"tui",
		"agent"
	],
	"author": "Astralyn",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/ming-kang/pi"
	},
	"publishConfig": {
		"access": "public",
		"tag": "latest"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
